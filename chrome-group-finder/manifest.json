{
  "manifest_version": 3,
  "name": "Group Finder Pro — Chrome Helper",
  "version": "0.5.22",
  "description": "Find public Facebook Groups and capture verified visible Main Post activity without reading comments.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://group-finder-pro-main-post-v2-preview.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Group Finder Pro",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/search/groups/*",
        "https://www.facebook.com/groups/*",
        "https://group-finder-pro-main-post-v2-preview.onrender.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
