{
  "manifest_version": 3,
  "name": "Group Finder Pro — Chrome Helper",
  "version": "0.5.20",
  "description": "Find public Facebook Groups and capture visible Facebook post evidence and transfer screenshot fixtures to the website for one-post recognition tests. Does not join groups or post.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://top-facebook-group-finder-preview.onrender.com/*",
    "https://group-finder-one-post-test-v2.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Group Finder Pro",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/search/groups/*",
        "https://www.facebook.com/groups/*",
        "https://top-facebook-group-finder-preview.onrender.com/*",
        "https://group-finder-one-post-test-v2.onrender.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
